{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "lesson": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": { "type": "string" },
            "check": { "type": "string" },
            "rationale": { "type": "string" },
            "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]+$" }, "minItems": 1, "maxItems": 8 }
          },
          "required": ["condition", "check", "rationale", "evidence_ids"]
        }
      ]
    }
  },
  "required": ["summary", "lesson"]
}
