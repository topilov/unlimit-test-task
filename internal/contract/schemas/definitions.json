{
  "hypotheses": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "supported",
            "weakened",
            "rejected"
          ]
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          }
        },
        "contradicting_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E[0-9]+$"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contradicting_evidence",
        "id",
        "missing_evidence",
        "statement",
        "status",
        "supporting_evidence"
      ],
      "additionalProperties": false
    }
  },
  "open_questions": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "why_it_matters"
      ],
      "additionalProperties": false
    }
  },
  "owner": {
    "type": "string",
    "enum": [
      "tech_ops",
      "callback_platform",
      "payment_processing",
      "merchant_integration",
      "provider_operations"
    ]
  },
  "action": {
    "type": "string",
    "enum": [
      "continue_investigation",
      "escalate_internal",
      "request_external_information",
      "monitor_recovery",
      "propose_closure"
    ]
  },
  "claim": {
    "type": "string",
    "enum": [
      "callback_attempts_missing",
      "receiver_503_observed",
      "callback_source_incomplete",
      "queue_degraded",
      "queue_healthy",
      "provider_status_stale"
    ]
  }
}
